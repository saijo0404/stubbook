# ==========================================
# StubBook Environment Configuration Example
# ==========================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# Local SQLite Database (Optional, defaults to ./data/stubbook.db)
DATABASE_PATH=./data/stubbook.db

# Optional: Setlist.fm & Spotify Integrations (Phase 4)
SETLIST_FM_API_KEY=your-setlist-fm-api-key
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
