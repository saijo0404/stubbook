{
  "name": "stubbook",
  "version": "2.2.0",
  "private": true,
  "description": "Concert journey & memory logging app with intelligent web scraping pipeline and structured archival.",
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "cap:sync": "pnpm --filter @stubbook/web cap:sync",
    "build:mobile": "pnpm --filter @stubbook/web build:mobile",
    "build:android": "pnpm --filter @stubbook/web build:android",
    "build:ios": "pnpm --filter @stubbook/web build:ios"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
